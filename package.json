{
  "name": "quaymesh",
  "version": "0.1.0",
  "private": true,
  "description": "An MCP workspace runtime for tasks, coding agents, and files across Windows and Linux.",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.19 <27"
  },
  "packageManager": "pnpm@11.25.0",
  "bin": {
    "quaymesh": "bin/quaymesh.js",
    "quaymesh-agentd": "bin/quaymesh-agentd.js"
  },
  "files": [
    "bin",
    "node",
    "dist",
    "components",
    "schema",
    "skills",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "components.lock.json",
    "docs",
    "scripts/analysis",
    "scripts/recover-workspace-roots.mjs",
    "scripts/fix-node-pty-permissions.mjs",
    "app.ico"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "node scripts/build.mjs",
    "build:release": "node scripts/build-bundle.mjs",
    "build:app": "vite build && vite build --config vite.card.config.ts && node scripts/copy-fleet-assets.mjs",
    "build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1",
    "verify:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-windows.ps1",
    "package:source": "python scripts/package-source.py",
    "dev": "node scripts/dev.mjs",
    "dev:seed": "tsx scripts/dev-state.ts seed",
    "dev:reset": "tsx scripts/dev-state.ts reset",
    "postinstall": "node scripts/fix-node-pty-permissions.mjs",
    "schema:config": "tsx scripts/generate-config-schema.ts",
    "start": "node bin/quaymesh.js run",
    "test": "tsx scripts/test-with-receipt.ts",
    "test:source-shards": "node scripts/test-source-shards.mjs",
    "test:package-install": "tsx --test --test-concurrency=1 \"test/package-install-smoke.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:federation": "tsx --test test/federation/*.test.ts",
    "protocol:codex": "tsx scripts/generate-codex-protocol.ts",
    "codex:prepare": "tsx scripts/prepare-codex-version.ts",
    "test:session": "tsx scripts/test-session-redesign.ts",
    "test:session:browser": "playwright test --config test/session-card/playwright.config.ts",
    "test:session:codex": "tsx --test test/session-card/codex-live.test.ts",
    "check:session-surface": "tsx scripts/check-session-surface.ts",
    "test:node": "node --test node/test/*.test.mjs",
    "build:bundle": "node scripts/build-bundle.mjs",
    "build:components": "node scripts/build-components.mjs",
    "test:console": "tsx --test --test-concurrency=1 test/console-v5/*.test.ts src/console-session-policy.test.ts",
    "test:console:browser": "playwright test --config test/console-v5/experience.playwright.ts",
    "test:console:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-windows-console.ps1",
    "test:reliability": "tsx --test --test-concurrency=1 test/reliability-upgrade.test.ts",
    "test:reliability:browser": "playwright test --config test/session-card/playwright.config.ts reliability-card.spec.ts",
    "test:tool-contract": "node --import tsx --test --test-timeout=60000 --test-concurrency=1 test/tool-contract/federation.test.ts test/tool-contract/instructions.test.ts test/tool-contract/batch.test.ts test/tool-contract/output.test.ts test/tool-contract/parallel.test.ts",
    "test:instructions": "node --import tsx --test --test-timeout=60000 --test-concurrency=1 test/tool-contract/instructions.test.ts src/session/context-reads.test.ts",
    "test:batch": "node --import tsx --test --test-timeout=60000 --test-concurrency=1 test/tool-contract/batch.test.ts test/tool-contract/output.test.ts",
    "test:parallel": "node --import tsx --test --test-timeout=60000 --test-concurrency=1 test/tool-contract/parallel.test.ts",
    "test:python": "node --import tsx --test --test-timeout=60000 --test-concurrency=1 test/python-workflow.test.ts",
    "test:deployment-lifecycle": "node --import tsx --test --test-timeout=60000 --test-concurrency=1 test/deployment-lifecycle.test.ts test/tool-contract/federation.test.ts",
    "measure:tool-contract": "tsx scripts/measure-tool-contract.ts",
    "export:card-preview": "pnpm build:app && node scripts/export-card-preview.mjs"
  },
  "keywords": [
    "mcp",
    "ai-agents",
    "workspace",
    "remote-execution",
    "windows",
    "linux"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.1.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.200",
    "@anthropic-ai/sandbox-runtime": "0.0.71",
    "@clack/prompts": "^1.5.1",
    "@earendil-works/pi-coding-agent": "^0.80.3",
    "@modelcontextprotocol/ext-apps": "^1.7.2",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@opencode-ai/sdk": "1.17.13",
    "@pierre/diffs": "^1.3.6",
    "better-result": "^2.10.0",
    "better-sqlite3": "13.0.3",
    "cross-spawn": "^7.0.6",
    "diff": "^8.0.3",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "jsonc-parser": "^3.3.1",
    "koffi": "^3.1.2",
    "lucide": "^1.24.0",
    "prismjs": "^1.30.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "semver": "^7.8.4",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "socks": "2.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^6.0.2",
    "parse5": "^8.0.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "undici": "8.5.0",
    "vite": "^8.0.14",
    "vite-plugin-singlefile": "2.3.3"
  },
  "overrides": {
    "protobufjs": "7.6.4",
    "ws": "8.21.0",
    "undici": "8.5.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ershiyidian/QuayMesh.git"
  },
  "homepage": "https://github.com/ershiyidian/QuayMesh#readme",
  "bugs": {
    "url": "https://github.com/ershiyidian/QuayMesh/issues"
  }
}

{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "tokenEnv": {
      "type": "string",
      "pattern": "^[A-Z_][A-Z0-9_]*$"
    },
    "coordinator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "address": {
          "type": "string",
          "minLength": 1
        },
        "apiPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "mcpPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "peerPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "required": [
        "id",
        "address"
      ]
    },
    "mesh": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "networkName": {
          "type": "string",
          "minLength": 1
        },
        "secretEnv": {
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]*$"
        },
        "peers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "networkName",
        "peers"
      ]
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tunnelIdEnv": {
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]*$"
        },
        "apiKeyEnv": {
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]*$"
        },
        "resourceUrl": {
          "type": "string",
          "minLength": 1
        },
        "apiBaseUrl": {
          "type": "string",
          "minLength": 1
        },
        "channels": {
          "type": "array",
          "items": {
            "enum": [
              "main",
              "harpoon"
            ]
          },
          "contains": {
            "const": "main"
          }
        },
        "localPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "healthPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "egress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "priorities": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          }
        },
        "probeUrl": {
          "type": "string",
          "minLength": 1
        },
        "recoveryDelayMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300000
        }
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "coordinator",
    "mesh"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quaymesh:cluster:1",
  "title": "QuayMesh 集群配置"
}
